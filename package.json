{
  "name": "stella",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @stella/web dev",
    "build": "pnpm --filter @stella/web build",
    "test": "vitest run",
